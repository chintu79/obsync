# Optional release signing configuration for Obsync Android builds.
#
# Copy this file to `keystore.properties` and fill in the values to sign
# release builds. If the file is absent, release builds fall back to the
# Android debug keystore (fine for testing, not for Play Store distribution).
#
#   cp keystore.properties.example keystore.properties
#
# Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore -alias obsync \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=change-me
keyAlias=obsync
keyPassword=change-me
